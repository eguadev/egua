var tp = importar("tempo");
var erros_tp = 0;

função testa_tempo_agora() {
  var obtido = tp.agora();
  se (obtido == nulo) {
    escreva("TESTE: tempo.agora(): falhou!");
    erros_tp = erros_tp + 1;
    retorna;
  }
  escreva("TESTE: tempo.agora(): passou!");
}

função testa_tempo_segundos_minutos_horas() {
  var s = tp.segundos();
  var mi = tp.minutos();
  var h = tp.horas();
  se (s == nulo ou mi == nulo ou h == nulo) {
    escreva("TESTE: tempo.segundos/minutos/horas(): falhou!");
    erros_tp = erros_tp + 1;
    retorna;
  }
  escreva("TESTE: tempo.segundos/minutos/horas(): passou!");
}

função testa_texto_para_data_válida() {
  var data = tp.texto_para_data("15/06/2024");
  se (data == nulo) {
    escreva("TESTE: tempo.texto_para_data() com data válida: falhou!");
    erros_tp = erros_tp + 1;
    retorna;
  }
  escreva("TESTE: tempo.texto_para_data() com data válida: passou!");
}

função testa_texto_para_data_inválida() {
  tente {
    tp.texto_para_data("31/02/2024");
    escreva("TESTE: tempo.texto_para_data() rejeita data inexistente: falhou!");
    erros_tp = erros_tp + 1;
  } pegue {
    escreva("TESTE: tempo.texto_para_data() rejeita data inexistente: passou!");
  }
}

