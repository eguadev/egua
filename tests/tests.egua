var erros_reg = 0;

função testa_tamanho_texto_numérico() {
  var obtido = tamanho("5");
  se (obtido != 1) {
    escreva("TESTE: tamanho('5') retorna 1: falhou!");
    erros_reg = erros_reg + 1;
    retorna;
  }
  escreva("TESTE: tamanho('5') retorna 1: passou!");
}

função testa_aleatório_entre_zero() {
  var obtido = aleatório_entre(0, 5);
  se (obtido == nulo) {
    escreva("TESTE: aleatório_entre(0, 5): falhou!");
    erros_reg = erros_reg + 1;
    retorna;
  }
  escreva("TESTE: aleatório_entre(0, 5): passou!");
}

função testa_reduzir_padrão_falsy() {
  var array = [1, 2, 3];
  var fn = função(total, valor) { retorna total + valor; };
  var obtido = reduzir(array, fn, 0);
  se (obtido != 6) {
    escreva("TESTE: reduzir com padrão 0: falhou!");
    escreva("| esperado: '6'");
    escreva("| obtido: '" + texto(obtido) + "'");
    erros_reg = erros_reg + 1;
    retorna;
  }
  escreva("TESTE: reduzir com padrão 0: passou!");
}

função testa_incluído_estrito() {
  var array = [1, 2, 3];
  var obtido = incluído(array, "1");
  se (obtido != falso) {
    escreva("TESTE: incluído() com igualdade estrita: falhou!");
    erros_reg = erros_reg + 1;
    retorna;
  }
  escreva("TESTE: incluído() com igualdade estrita: passou!");
}

