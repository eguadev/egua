  var j = [1,2,2,3,3];
  var moda_dois = m.moda(j);
  var k = [1,2,3,4,5];
  var moda_tres = m.moda(k);
  
  se (moda_um[0] == 2)
    escreva(moda_um);
  senão {
    erros_m = erros_m+1;
    escreva(erros_m);
  }
  se (moda_dois[0] == 2 e moda_dois[1] == 3)
    escreva(moda_dois);
  senão {
    erros_m = erros_m+1;
    escreva(erros_m);
  }

  se (moda_tres)
    escreva(moda_tres);
  senão {
    erros_m = erros_m+1;
    escreva(erros_m);
  }
}

