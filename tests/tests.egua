função testa_aprox_vetor() {
  var obtido = m.aprox([1.2345, 2.3456], 2);
  se (obtido == nulo) {
    escreva("TESTE: aprox() com vetor: falhou!");
    erros_reg = erros_reg + 1;
    retorna;
  }
  escreva("TESTE: aprox() com vetor: passou!");
}

função testa_atributos_com_valores_falsy() {
  classe ExemploClasse {
    construtor() {
      isto.zero = 0;
      isto.lógico = falso;
      isto.vazio = "";
    }
  }

  var exemplo = ExemploClasse();
  var dicionário = {
    "zero": 0,
    "lógico": falso,
    "vazio": ""
  };

  se (exemplo.zero != 0 ou dicionário.zero != 0) {
    escreva("TESTE: atributo/propriedade com 0: falhou!");
    erros_reg = erros_reg + 1;
    retorna;
  }
  se (exemplo.lógico != falso ou dicionário.lógico != falso) {
    escreva("TESTE: atributo/propriedade com falso: falhou!");
    erros_reg = erros_reg + 1;
    retorna;
  }
  se (exemplo.vazio != "" ou dicionário.vazio != "") {
    escreva("TESTE: atributo/propriedade com texto vazio: falhou!");
    erros_reg = erros_reg + 1;
    retorna;
  }
  escreva("TESTE: atributos e propriedades preservam valores falsy: passou!");
}

testa_tamanho_texto_numérico();
