função teste_aleatório_entre(){
  var ran = aleatório_entre(3);

  se (ran < 3) {
    escreva(ran);
  } senão {
    erros_m = erros_m+1;
    escreva(erros_m);
  }

  var ran2 = aleatório_entre(1,3);

  se (ran2 >= 1) {
    se (ran2 < 3) {
      escreva(ran2);
    } senão {
      erros_m = erros_m+1;
      escreva(erros_m);
    }
  } senão {
    erros_m = erros_m+1;
    escreva(erros_m);
  }
}

