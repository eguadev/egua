var erros_r = 0;

função testa_requisição_módulo() {
  var r = importar("requisição");

  se (r == nulo) {
    escreva("TESTE: módulo requisição: falhou ao importar!");
    erros_r = erros_r + 1;
    retorna;
  }
  escreva("TESTE: módulo requisição: importado com sucesso!");
}

função testa_requisição_funções() {
  var r = importar("requisição");

  var fn_obter = r.obter;
  se (fn_obter == nulo) {
    escreva("TESTE: requisição.obter: nao encontrado!");
    erros_r = erros_r + 1;
    retorna;
  }

  var fn_enviar = r.enviar;
  se (fn_enviar == nulo) {
    escreva("TESTE: requisição.enviar: nao encontrado!");
    erros_r = erros_r + 1;
    retorna;
  }

  var fn_atualizar = r.atualizar;
  se (fn_atualizar == nulo) {
    escreva("TESTE: requisição.atualizar: nao encontrado!");
    erros_r = erros_r + 1;
    retorna;
  }

  var fn_excluir = r.excluir;
  se (fn_excluir == nulo) {
    escreva("TESTE: requisição.excluir: nao encontrado!");
    erros_r = erros_r + 1;
    retorna;
  }

  escreva("TESTE: funções obter, enviar, atualizar, excluir: OK!");
}

testa_requisição_módulo();
testa_requisição_funções();

escreva("----------------------------");
escreva("  terminado com " + texto(erros_r) + " erro(s)!");
escreva("----------------------------");

